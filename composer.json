{
  "name": "easysql/sdk",
  "description": "EasySQL API PHP SDK — Ask questions in natural language to your MySQL, MariaDB or PostgreSQL databases.",
  "type": "library",
  "license": "MIT",
  "version": "1.3.0",
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "files": [
      "src/token-store.php"
    ],
    "psr-4": {
      "Clearsoft\\EasySQL\\SDK\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Clearsoft\\EasySQL\\SDK\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "EasySQL",
      "homepage": "https://easysql.net"
    }
  ]
}
