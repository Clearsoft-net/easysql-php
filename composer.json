{
  "name": "clearsoft/easysql-sdk",
  "description": "EasySQL PHP SDK — multipackage repository (client, connectors, schema generation, Laravel integration).",
  "type": "library",
  "license": "MIT",
  "version": "3.0.0",
  "homepage": "https://easysql.net",
  "keywords": [
    "easysql",
    "clearsoft",
    "sql",
    "ai",
    "llm",
    "database",
    "api",
    "sdk",
    "laravel",
    "php"
  ],
  "support": {
    "issues": "https://github.com/Clearsoft-net/easysql-php/issues",
    "source": "https://github.com/Clearsoft-net/easysql-php"
  },
  "authors": [
    {
      "name": "Clearsoft",
      "email": "contact@clearsoft.net",
      "homepage": "https://clearsoft.net"
    }
  ],
  "require": {
    "php": ">=8.2",
    "easysql/client": "^3.0",
    "easysql/schema-generation": "^3.0"
  },
  "suggest": {
    "easysql/laravel": "Laravel service provider, manager and facade (^3.0)",
    "easysql/connectors-mysql": "Local MySQL/MariaDB introspection and execution (^3.0)",
    "easysql/connectors-postgres": "Local PostgreSQL introspection and execution (^3.0)",
    "easysql/connectors-sqlite": "Local SQLite introspection and execution (^3.0)",
    "easysql/connectors-clickhouse": "Local ClickHouse introspection and execution (^3.0)"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "orchestra/testbench": "^10.0",
    "illuminate/support": "^12.0",
    "illuminate/contracts": "^12.0",
    "easysql/laravel": "^3.0",
    "easysql/connectors-mysql": "^3.0",
    "easysql/connectors-postgres": "^3.0",
    "easysql/connectors-sqlite": "^3.0",
    "easysql/connectors-clickhouse": "^3.0",
    "phpstan/phpstan": "^2.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/*"
    },
    {
      "type": "path",
      "url": "packages/*/*"
    }
  ],
  "autoload-dev": {
    "psr-4": {
      "Clearsoft\\EasySQL\\Client\\Tests\\": "packages/client/tests/",
      "Clearsoft\\EasySql\\Laravel\\Tests\\": "packages/laravel/tests/",
      "Clearsoft\\EasySQL\\Connectors\\MySQL\\Tests\\": "packages/connectors/mysql/tests/",
      "Clearsoft\\EasySQL\\Connectors\\Postgres\\Tests\\": "packages/connectors/postgres/tests/",
      "Clearsoft\\EasySQL\\Connectors\\SQLite\\Tests\\": "packages/connectors/sqlite/tests/",
      "Clearsoft\\EasySQL\\Connectors\\ClickHouse\\Tests\\": "packages/connectors/clickhouse/tests/",
      "Clearsoft\\EasySQL\\Common\\Tests\\": "packages/common/tests/",
      "Clearsoft\\EasySQL\\SchemaGeneration\\Tests\\": "packages/schema-generation/tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit",
    "build": [
      "@generate",
      "@test",
      "@analyse"
    ],
    "generate": "php scripts/generate.php"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  }
}
