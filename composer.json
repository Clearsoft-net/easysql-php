{
  "name": "clearsoft/easysql-sdk",
  "description": "EasySQL API PHP & Laravel SDK — Ask questions in natural language to your MySQL, MariaDB or PostgreSQL databases.",
  "type": "library",
  "license": "MIT",
  "version": "1.4.0",
  "homepage": "https://easysql.net",
  "keywords": [
    "easysql",
    "clearsoft",
    "sql",
    "ai",
    "llm",
    "database",
    "api",
    "sdk",
    "laravel",
    "php"
  ],
  "support": {
    "issues": "https://github.com/Clearsoft-net/easysql-php/issues",
    "source": "https://github.com/Clearsoft-net/easysql-php"
  },
  "authors": [
    {
      "name": "Clearsoft",
      "email": "contact@clearsoft.net",
      "homepage": "https://clearsoft.net"
    }
  ],
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "orchestra/testbench": "^9.0",
    "illuminate/support": "^11.0",
    "illuminate/contracts": "^11.0"
  },
  "suggest": {
    "illuminate/support": "Required to use the Laravel Service Provider and Facade (^11.0)"
  },
  "autoload": {
    "files": [
      "src/token-store.php"
    ],
    "psr-4": {
      "Clearsoft\\EasySQL\\SDK\\": "src/",
      "Clearsoft\\EasySql\\Laravel\\": "src/Laravel/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Clearsoft\\EasySQL\\SDK\\Tests\\": "tests/",
      "Clearsoft\\EasySql\\Laravel\\Tests\\": "tests/Laravel/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Clearsoft\\EasySql\\Laravel\\EasySqlServiceProvider"
      ],
      "aliases": {
        "EasySQL": "Clearsoft\\EasySql\\Laravel\\Facades\\EasySQL"
      }
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  }
}
