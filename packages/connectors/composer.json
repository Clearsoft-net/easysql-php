{
  "name": "clearsoft/easysql-connectors",
  "description": "EasySQL connector package — local schema introspection and SELECT execution for MySQL/MariaDB, PostgreSQL, SQLite, ClickHouse, SQL Server, Oracle, Firebird, Db2, DuckDB, libSQL, Cloudflare D1, Snowflake, BigQuery, Trino and SAP HANA.",
  "type": "library",
  "license": "MIT",
  "version": "4.1.0",
  "homepage": "https://easysql.net",
  "keywords": [
    "easysql",
    "clearsoft",
    "connector",
    "mysql",
    "mariadb",
    "postgres",
    "sqlite",
    "clickhouse",
    "sqlserver",
    "oracle",
    "firebird",
    "db2",
    "duckdb",
    "libsql",
    "d1",
    "snowflake",
    "bigquery",
    "trino",
    "hana",
    "database",
    "sdk",
    "php"
  ],
  "support": {
    "issues": "https://github.com/Clearsoft-net/easysql-php/issues",
    "source": "https://github.com/Clearsoft-net/easysql-php"
  },
  "authors": [
    {
      "name": "Clearsoft",
      "email": "contact@clearsoft.net",
      "homepage": "https://clearsoft.net"
    }
  ],
  "require": {
    "php": ">=8.2",
    "clearsoft/easysql-common": "^4.0",
    "ext-pdo": "*"
  },
  "suggest": {
    "ext-pdo_mysql": "Required for the MySQL/MariaDB connector",
    "ext-pdo_pgsql": "Required for the PostgreSQL connector",
    "ext-pdo_sqlite": "Required for the SQLite connector",
    "ext-curl": "Required for the ClickHouse, Trino, Cloudflare D1 and remote libSQL connectors",
    "ext-pdo_sqlsrv": "Required for the SQL Server connector",
    "ext-pdo_oci": "Required for the Oracle connector",
    "ext-pdo_firebird": "Required for the Firebird connector",
    "ext-pdo_ibm": "Required for the Db2 connector",
    "ext-pdo_odbc": "Required for the Snowflake and SAP HANA connectors",
    "ext-pdo_duckdb": "Required for the DuckDB connector",
    "google/cloud-bigquery": "Required for the BigQuery connector"
  },
  "autoload": {
    "psr-4": {
      "Clearsoft\\EasySQL\\Connectors\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Clearsoft\\EasySQL\\Connectors\\Tests\\": "tests/"
    }
  }
}
